{
  "name": "@groundwork/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "db:migrate": "node --env-file-if-exists=.env src/auth/migrate.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:related": "vitest related --run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@effect/platform-node": "^4.1.2",
    "@google-cloud/bigquery": "^9.3.0",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "effect": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "^4.1.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "1.86.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
