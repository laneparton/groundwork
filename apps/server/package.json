{
  "name": "@groundwork/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "db:migrate": "node --env-file-if-exists=.env src/auth/migrate.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --test \"src/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@effect/platform-node": "^4.1.2",
    "@google-cloud/bigquery": "^9.3.0",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "effect": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@types/node": "^24.19.1",
    "oxlint": "1.86.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
