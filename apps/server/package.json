{
  "name": "@groundwork/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env src/auth/migrate.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@effect/platform-node": "^4.0.0",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2"
  }
}
